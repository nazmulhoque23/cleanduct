# Copy to .env and adjust. The server reads plain environment variables;
# use `set -a; source .env; set +a` or Docker Compose env_file.

ADDR=:8080
DB_PATH=./data/site.db

# Path to the built frontend (frontend/dist). Leave empty in dev — Vite
# serves the frontend and proxies /api to this server.
STATIC_DIR=

# Allowed browser origin(s) for the API in dev (comma-separated).
CORS_ORIGIN=http://localhost:5173

# Set to enable GET/PATCH /api/admin/leads (Authorization: Bearer <token>).
ADMIN_TOKEN=change-me

# Public URL of the site (no trailing slash) — used for canonical links, sitemap, OG tags, HSTS.
PUBLIC_URL=http://localhost:8080

# ---- Notifications (all optional; nothing configured = log only) ----------
# Email: EITHER a Resend API key (simplest, https://resend.com) OR SMTP.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM=leads@yourdomain.com     # must be a verified sender for Resend/SMTP
NOTIFY_TO=owner@yourdomain.com       # where new leads/bookings are emailed
# SMS to the owner via Twilio (optional)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=+15550000000
TWILIO_TO=+15550000001

# ---- Online booking --------------------------------------------------------
BOOKING_CAPACITY=2                   # jobs accepted per arrival window per day
BOOKING_DAYS=14                      # how far ahead customers can book
BOOKING_LEAD_DAYS=1                  # earliest bookable day = today + N
BOOKING_WINDOWS=08:00-10:00|10:00-12:00|12:00-14:00|14:00-16:00|16:00-18:00

# Business identity shown in header/footer (placeholders — replace with real data).
SITE_NAME=CleanDuct
SITE_TAGLINE=Cleaner air. Safer home. Honest pricing.
SITE_PHONE=(312) 555-0148
SITE_EMAIL=hello@cleanduct.example
SITE_ADDRESS=7 N Roselle Rd, Schaumburg, IL 60193
SITE_HOURS=Mon–Fri 7:00 AM – 8:00 PM|Sat 8:00 AM – 6:00 PM|Sun Closed
SITE_RATING=4.9
SITE_REVIEW_COUNT=1284
SITE_YEAR_FOUNDED=2011
SOCIAL_FACEBOOK=#
SOCIAL_INSTAGRAM=#
SOCIAL_YOUTUBE=#
SOCIAL_GOOGLE=#
