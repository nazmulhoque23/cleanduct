# Copy to .env and adjust. The server reads plain environment variables;
# use `set -a; source .env; set +a` or Docker Compose env_file.

ADDR=:8080
DB_PATH=./data/site.db

# Path to the built frontend (frontend/dist). Leave empty in dev — Vite
# serves the frontend and proxies /api to this server.
STATIC_DIR=

# Allowed browser origin(s) for the API in dev (comma-separated).
CORS_ORIGIN=http://localhost:5173

# Set to enable GET/PATCH /api/admin/leads (Authorization: Bearer <token>).
ADMIN_TOKEN=change-me

# Optional: email each new lead to the owner. Leave SMTP_HOST empty to log only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM=leads@yourdomain.com
NOTIFY_TO=owner@yourdomain.com

# Business identity shown in header/footer (placeholders — replace with real data).
SITE_NAME=CleanDuct
SITE_TAGLINE=Cleaner air. Safer home. Honest pricing.
SITE_PHONE=(312) 555-0148
SITE_EMAIL=hello@cleanduct.example
SITE_ADDRESS=7 N Roselle Rd, Schaumburg, IL 60193
SITE_HOURS=Mon–Fri 7:00 AM – 8:00 PM|Sat 8:00 AM – 6:00 PM|Sun Closed
SITE_RATING=4.9
SITE_REVIEW_COUNT=1284
SITE_YEAR_FOUNDED=2011
SOCIAL_FACEBOOK=#
SOCIAL_INSTAGRAM=#
SOCIAL_YOUTUBE=#
SOCIAL_GOOGLE=#
